generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ============================================================
// BETTER AUTH — CORE
// ============================================================

model User {
  id            String   @id @default(cuid())
  name          String
  email         String   @unique
  emailVerified Boolean  @default(false)
  image         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  sessions        Session[]
  accounts        Account[]
  members         Member[]
  invitationsSent Invitation[] @relation("InvitationInviter")

  @@map("user")
}

model Session {
  id                    String   @id @default(cuid())
  userId                String
  token                 String   @unique
  expiresAt             DateTime
  ipAddress             String?
  userAgent             String?
  activeOrganizationId  String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("session")
}

model Account {
  id                    String    @id @default(cuid())
  userId                String
  accountId             String
  providerId            String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([providerId, accountId])
  @@map("account")
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("verification")
}

// ============================================================
// BETTER AUTH — ORGANIZATION PLUGIN (fondasi multi-tenant)
// ============================================================

model Organization {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  logo      String?
  metadata  String?
  createdAt DateTime @default(now())

  members          Member[]
  invitations      Invitation[]
  athletes         Athlete[]
  assessmentComponents AssessmentComponent[]
  testItems        TestItem[]
  assessments      Assessment[]
  benchmarks       Benchmark[]
  scheduleSessions ScheduleSession[]
  exercises        Exercise[]
  trainingPlans    TrainingPlan[]
  sessionLogs      SessionLog[]
  portalAccesses   PortalAccess[]
  coachGuidances   CoachGuidance[]
  attendances      Attendance[]
  parentFeedbacks  ParentFeedback[]
  goals            AthleteGoal[]
  rescheduleRequests RescheduleRequest[]

  @@map("organization")
}

model Member {
  id             String   @id @default(cuid())
  organizationId String
  userId         String
  role           String   @default("assistant_coach")
  phone          String?
  createdAt      DateTime @default(now())

  organization            Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user                    User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  assessmentsCreated      Assessment[]
  reportsGenerated        Report[]
  scheduleSessionsCoached ScheduleSession[]
  sessionLogsCreated      SessionLog[]
  portalAccessesCreated   PortalAccess[]
  coachGuidances          CoachGuidance[]
  attendancesMarked       Attendance[]          @relation("AttendanceMarker")
  feedbacksReceived       ParentFeedback[]      @relation("CoachEvaluated")
  goalsCreated            AthleteGoal[]         @relation("GoalCreator")
  rescheduleRequests      RescheduleRequest[]   @relation("RescheduleRequester")
  rescheduleReviews       RescheduleRequest[]   @relation("RescheduleReviewer")
  assignedAthletes        Athlete[]             @relation("AthleteAssignedCoach")
  scheduleSessionsExecuted ScheduleSession[]    @relation("SessionExecutor")

  @@unique([organizationId, userId])
  @@map("member")
}

model Invitation {
  id             String   @id @default(cuid())
  organizationId String
  email          String
  role           String   @default("assistant_coach")
  status         String   @default("pending")
  inviterId      String
  expiresAt      DateTime
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  inviter      User         @relation("InvitationInviter", fields: [inviterId], references: [id])

  @@map("invitation")
}

// ============================================================
// ATHLETE
// ============================================================

enum AthletePosition {
  POINT_GUARD
  SHOOTING_GUARD
  SMALL_FORWARD
  POWER_FORWARD
  CENTER
  UNSPECIFIED
}

enum TrainingLevel {
  BEGINNER
  INTERMEDIATE
  ADVANCED
  ELITE
}

enum Gender {
  MALE
  FEMALE
}

model Athlete {
  id             String @id @default(cuid())
  organizationId String

  fullName      String
  jerseyNumber  Int?
  sportCategory String? // Misal: Basket, Sepak Bola, Bulutangkis, Futsal, Atletik, dll.
  position      AthletePosition @default(UNSPECIFIED)
  trainingLevel TrainingLevel   @default(BEGINNER)
  gender        Gender
  dateOfBirth   DateTime
  photoUrl      String?

  heightCm   Decimal? @db.Decimal(5, 1)
  weightKg   Decimal? @db.Decimal(5, 1)
  wingspanCm Decimal? @db.Decimal(5, 1)

  parentName   String?
  parentPhone  String?
  allergies    String?
  healthNotes  String?

  competitionLevel String?
  assignedCoachId  String?

  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization     Organization             @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  assignedCoach    Member?                  @relation("AthleteAssignedCoach", fields: [assignedCoachId], references: [id], onDelete: SetNull)
  injuryHistories  AthleteInjuryHistory[]
  assessments      Assessment[]
  scheduleSessions ScheduleSessionAthlete[]
  trainingPlans    TrainingPlan[]
  sessionLogs      SessionLog[]
  portalAccesses   PortalAccess[]
  coachGuidances   CoachGuidance[]
  attendances      Attendance[]
  parentFeedbacks  ParentFeedback[]
  goals            AthleteGoal[]

  @@index([organizationId])
  @@map("athlete")
}

// ============================================================
// ATHLETE & PARENT SECURE PORTAL ACCESS
// ============================================================

model PortalAccess {
  id                String    @id @default(cuid())
  organizationId    String
  athleteId         String
  createdByMemberId String

  tokenHash     String    @unique
  username      String?   @unique
  passwordHash  String?
  plainPassword String?
  accessType    String    @default("ATHLETE") // "ATHLETE" | "PARENT"
  expiresAt     DateTime
  revokedAt     DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  athlete        Athlete          @relation(fields: [athleteId], references: [id], onDelete: Cascade)
  createdBy      Member           @relation(fields: [createdByMemberId], references: [id])
  parentFeedbacks ParentFeedback[]

  @@index([organizationId, athleteId])
  @@index([tokenHash])
  @@map("portal_access")
}

model AthleteInjuryHistory {
  id          String    @id @default(cuid())
  athleteId   String
  injuryType  String
  description String?
  injuryDate  DateTime
  recoveredAt DateTime?
  severity    String?
  createdAt   DateTime  @default(now())

  athlete Athlete @relation(fields: [athleteId], references: [id], onDelete: Cascade)

  @@index([athleteId])
  @@map("athlete_injury_history")
}

model AssessmentComponent {
  id             String   @id @default(cuid())
  organizationId String

  name        String
  description String?
  order       Int     @default(0)
  isActive    Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  testItems    TestItem[]

  @@index([organizationId])
  @@map("assessment_component")
}

enum PhysicalComponent {
  FLEXIBILITY
  SPEED
  POWER
  AGILITY
  MUSCULAR_ENDURANCE
  ANAEROBIC_ENDURANCE
  AEROBIC_ENDURANCE
}

enum ScoreDirection {
  HIGHER_IS_BETTER
  LOWER_IS_BETTER
}

enum TestType {
  NUMERIC
  QUALITATIVE
}

enum MeasurementUnit {
  CM
  M
  KG
  SECOND
  REPETITION
  ML_KG_MIN
  SCORE
}

model TestItem {
  id             String  @id @default(cuid())
  organizationId String
  componentId    String?

  physicalComponent PhysicalComponent?
  name              String
  unit              MeasurementUnit
  scoreDirection    ScoreDirection
  testType          TestType          @default(NUMERIC)

  order    Int     @default(0)
  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  component    AssessmentComponent?   @relation(fields: [componentId], references: [id], onDelete: SetNull)
  resultItems  AssessmentResultItem[]
  benchmarks   Benchmark[]
  goals        AthleteGoal[]

  @@index([organizationId])
  @@index([componentId])
  @@map("test_item")
}

enum AssessmentStatus {
  DRAFT
  COMPLETED
}

enum AssessmentType {
  PROGRESS_BASED
  BENCHMARK_BASED
}

model Assessment {
  id                String @id @default(cuid())
  organizationId    String
  athleteId         String
  createdByMemberId String

  assessmentDate DateTime
  status         AssessmentStatus @default(DRAFT)
  assessmentType AssessmentType   @default(BENCHMARK_BASED)

  overallScore Decimal? @db.Decimal(5, 2)
  overallGrade String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  athlete      Athlete                @relation(fields: [athleteId], references: [id], onDelete: Cascade)
  createdBy    Member                 @relation(fields: [createdByMemberId], references: [id])
  resultItems  AssessmentResultItem[]
  analysis     AssessmentAnalysis?
  reports      Report[]
  goalsAchieved AthleteGoal[]        @relation("GoalAchievedAssessment")

  @@index([organizationId])
  @@index([athleteId, assessmentDate])
  @@map("assessment")
}

model AssessmentResultItem {
  id           String  @id @default(cuid())
  assessmentId String
  testItemId   String

  rawValue         Decimal? @db.Decimal(8, 2)
  qualitativeValue String?
  score            Decimal? @db.Decimal(5, 2)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  assessment Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  testItem   TestItem   @relation(fields: [testItemId], references: [id])

  @@unique([assessmentId, testItemId])
  @@map("assessment_result_item")
}

// ============================================================
// BENCHMARK
// ============================================================

model Benchmark {
  id             String @id @default(cuid())
  organizationId String
  testItemId     String

  ageMin           Int
  ageMax           Int
  gender           Gender?
  position         AthletePosition?
  competitionLevel String?

  // Ambang 0-100 -> grade A/B/C/D, dibaca sesuai TestItem.scoreDirection
  thresholdA Decimal @db.Decimal(8, 2)
  thresholdB Decimal @db.Decimal(8, 2)
  thresholdC Decimal @db.Decimal(8, 2)
  thresholdD Decimal @db.Decimal(8, 2)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  testItem     TestItem     @relation(fields: [testItemId], references: [id], onDelete: Cascade)

  @@index([organizationId, testItemId])
  @@map("benchmark")
}

// ============================================================
// ANALYSIS & REPORT
// ============================================================

model AssessmentAnalysis {
  id           String @id @default(cuid())
  assessmentId String @unique

  componentScores Json // { FLEXIBILITY: 74, SPEED: 81, ... } — dipakai langsung oleh radar chart
  bestComponent      PhysicalComponent?
  weakestComponents  PhysicalComponent[]

  insightText       String
  recommendationText String
  ruleEngineVersion  String // mis. "v1.0" — supaya hasil lama bisa ditandai kalau rule berubah

  generatedAt DateTime @default(now())

  assessment Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)

  @@map("assessment_analysis")
}

model Report {
  id           String @id @default(cuid())
  assessmentId String

  filePath           String // path di Supabase Storage
  version            Int     @default(1)
  isLatest           Boolean @default(true)
  generatedByMemberId String

  generatedAt DateTime @default(now())

  assessment    Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  generatedBy   Member     @relation(fields: [generatedByMemberId], references: [id])

  @@index([assessmentId, isLatest])
  @@map("report")
}

// ============================================================
// TRAINING SCHEDULE (SCHEDULED SESSIONS)
// ============================================================

enum ScheduleStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
  NO_SHOW
}

model ScheduleSession {
  id             String         @id @default(cuid())
  organizationId String
  coachId        String
  trainingPlanId String?

  title     String
  startTime DateTime
  endTime   DateTime
  status    ScheduleStatus @default(SCHEDULED)

  location String?
  notes    String?
  executorId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization        Organization             @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  coach               Member                   @relation(fields: [coachId], references: [id])
  executor            Member?                  @relation("SessionExecutor", fields: [executorId], references: [id], onDelete: SetNull)
  trainingPlan        TrainingPlan?            @relation(fields: [trainingPlanId], references: [id], onDelete: SetNull)
  athletes            ScheduleSessionAthlete[]
  sessionLogs         SessionLog[]
  attendances         Attendance[]
  parentFeedbacks     ParentFeedback[]
  rescheduleRequests  RescheduleRequest[]

  @@index([organizationId, startTime])
  @@index([trainingPlanId])
  @@map("schedule_session")
}

model ScheduleSessionAthlete {
  sessionId String
  athleteId String

  session ScheduleSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  athlete Athlete         @relation(fields: [athleteId], references: [id], onDelete: Cascade)

  @@id([sessionId, athleteId])
  @@map("schedule_session_athlete")
}

// ============================================================
// TRAINING PROGRAM / PLAN & EXERCISES
// ============================================================

model Exercise {
  id             String   @id @default(cuid())
  organizationId String

  name        String
  category    String? // Misal: Strength, Plyometrics, Core, Mobility
  description String?
  videoUrl    String?
  isActive    Boolean  @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization      Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  trainingExercises TrainingExercise[]

  @@index([organizationId])
  @@map("exercise")
}

enum TrainingPlanStatus {
  DRAFT
  ACTIVE
  COMPLETED
  ARCHIVED
}

model TrainingPlan {
  id             String   @id @default(cuid())
  organizationId String
  athleteId      String?  // Null jika berupa Template Program Organisasi

  title       String
  description String?
  startDate   DateTime?
  endDate     DateTime?
  status      TrainingPlanStatus @default(ACTIVE)
  isActive    Boolean            @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization     Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  athlete          Athlete?           @relation(fields: [athleteId], references: [id], onDelete: Cascade)
  exercises        TrainingExercise[]
  scheduleSessions ScheduleSession[]

  @@index([organizationId])
  @@map("training_plan")
}

model TrainingExercise {
  id             String  @id @default(cuid())
  trainingPlanId String
  exerciseId     String?

  name        String
  category    String? // Misal: Plyometrics, Core, Strength, Agility
  sets        Int?
  reps        String? // Misal: "10 reps" atau "30 detik"
  restSeconds Int?
  notes       String?
  order       Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  trainingPlan TrainingPlan @relation(fields: [trainingPlanId], references: [id], onDelete: Cascade)
  exercise     Exercise?     @relation(fields: [exerciseId], references: [id], onDelete: SetNull)

  @@index([trainingPlanId])
  @@index([exerciseId])
  @@map("training_exercise")
}

// ============================================================
// SESSION LOG (DAILY TRAINING LOG & VIDEO)
// ============================================================

model SessionLog {
  id                String   @id @default(cuid())
  organizationId    String
  athleteId         String
  scheduleSessionId String?
  createdByMemberId String

  sessionDate    DateTime @default(now())
  activitiesDone String
  coachFeedback  String?
  videoUrl       String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization    Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  athlete         Athlete          @relation(fields: [athleteId], references: [id], onDelete: Cascade)
  scheduleSession ScheduleSession? @relation(fields: [scheduleSessionId], references: [id], onDelete: SetNull)
  createdBy       Member           @relation(fields: [createdByMemberId], references: [id])

  @@index([organizationId, athleteId])
  @@index([scheduleSessionId])
  @@map("session_log")
}

// ============================================================
// COACH GUIDANCE & NEWS BULLETIN (PUSAT BERITA & EDUKASI)
// ============================================================

model CoachGuidance {
  id             String    @id @default(cuid())
  organizationId String
  authorId       String
  athleteId      String?   // Nullable: jika null, broadcast ke semua atlet/ortu; jika ada, privat untuk atlet tersebut

  title          String
  category       String    @default("NUTRISI") // "NUTRISI" | "LATIHAN_MANDIRI" | "PENGUMUMAN" | "KESEHATAN" | "MOTIVASI"
  content        String    @db.Text
  linkUrl        String?   // Optional URL artikel / video referensi
  isPinned       Boolean   @default(false)

  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  author         Member       @relation(fields: [authorId], references: [id])
  athlete        Athlete?     @relation(fields: [athleteId], references: [id], onDelete: Cascade)

  @@index([organizationId, createdAt])
  @@index([athleteId])
  @@map("coach_guidance")
}

// ============================================================
// P5: ATTENDANCE & PRESENSI ATLET
// ============================================================

enum AttendanceStatus {
  UNMARKED
  PRESENT
  LATE
  EXCUSED
  ABSENT
  RESCHEDULED
}

model Attendance {
  id             String           @id @default(cuid())
  organizationId String
  sessionId      String
  athleteId      String
  status         AttendanceStatus @default(UNMARKED)

  checkInTime      DateTime?
  notes            String?
  markedByMemberId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  session      ScheduleSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  athlete      Athlete         @relation(fields: [athleteId], references: [id], onDelete: Cascade)
  markedBy     Member?         @relation("AttendanceMarker", fields: [markedByMemberId], references: [id], onDelete: SetNull)

  @@unique([sessionId, athleteId])
  @@index([organizationId, sessionId, status])
  @@index([organizationId, athleteId, status])
  @@map("attendance")
}

// ============================================================
// P5: PARENT FEEDBACK & EVALUASI PELATIH
// ============================================================

model ParentFeedback {
  id                String   @id @default(cuid())
  organizationId    String
  scheduleSessionId String
  athleteId         String
  portalAccessId    String   // Required: Audit trail aktor token portal yang sah
  coachMemberId     String   // Server-determined: Diambil dari ScheduleSession.coachId

  // Rating 1 - 5 Bintang (Tervalidasi Integer 1..5)
  sessionRating          Int
  communicationRating    Int
  athleteAttentionRating Int

  comment String? @db.Text

  // Supervisi Head Coach / Admin (Mutable oleh Head Coach)
  isReviewed     Boolean   @default(false)
  reviewedAt     DateTime?
  headCoachNotes String?   @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization    Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  scheduleSession ScheduleSession @relation(fields: [scheduleSessionId], references: [id], onDelete: Cascade)
  athlete         Athlete         @relation(fields: [athleteId], references: [id], onDelete: Cascade)
  coachMember     Member          @relation("CoachEvaluated", fields: [coachMemberId], references: [id], onDelete: Restrict)
  portalAccess    PortalAccess    @relation(fields: [portalAccessId], references: [id], onDelete: Restrict)

  @@unique([scheduleSessionId, athleteId])
  @@index([organizationId, coachMemberId, createdAt])
  @@index([organizationId, isReviewed])
  @@index([organizationId, athleteId])
  @@map("parent_feedback")
}

// ============================================================
// ATHLETE GOALS & TARGETS (P6-B)
// ============================================================

enum GoalStatus {
  ACTIVE
  ACHIEVED
  PAUSED
  CANCELLED
  EXPIRED
}

model AthleteGoal {
  id                String     @id @default(cuid())
  organizationId    String
  athleteId         String
  testItemId        String
  createdByMemberId String

  title                String?
  baselineValue        Decimal         @db.Decimal(8, 2)
  targetValue          Decimal         @db.Decimal(8, 2)
  unit                 MeasurementUnit
  targetDate           DateTime?
  status               GoalStatus      @default(ACTIVE)
  notes                String?

  achievedAt           DateTime?
  achievedAssessmentId String?

  createdAt            DateTime        @default(now())
  updatedAt            DateTime        @updatedAt

  organization       Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  athlete            Athlete      @relation(fields: [athleteId], references: [id], onDelete: Cascade)
  testItem           TestItem     @relation(fields: [testItemId], references: [id], onDelete: Restrict)
  createdBy          Member       @relation("GoalCreator", fields: [createdByMemberId], references: [id], onDelete: Restrict)
  achievedAssessment Assessment?  @relation("GoalAchievedAssessment", fields: [achievedAssessmentId], references: [id], onDelete: SetNull)

  @@index([organizationId, athleteId])
  @@index([athleteId, testItemId, status])
  @@map("athlete_goal")
}

// ============================================================
// RESCHEDULE REQUESTS (Assistant Coach → Head Coach)
// ============================================================

enum RescheduleRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

model RescheduleRequest {
  id                    String                  @id @default(cuid())
  organizationId        String
  scheduleSessionId     String
  requestedByMemberId   String

  reason                String                  @db.Text
  status                RescheduleRequestStatus @default(PENDING)

  // Head Coach review
  reviewedByMemberId    String?
  reviewNote            String?                 @db.Text
  reviewedAt            DateTime?

  createdAt             DateTime                @default(now())
  updatedAt             DateTime                @updatedAt

  organization    Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  scheduleSession ScheduleSession @relation(fields: [scheduleSessionId], references: [id], onDelete: Cascade)
  requestedBy     Member          @relation("RescheduleRequester", fields: [requestedByMemberId], references: [id], onDelete: Restrict)
  reviewedBy      Member?         @relation("RescheduleReviewer", fields: [reviewedByMemberId], references: [id], onDelete: SetNull)

  @@unique([scheduleSessionId, requestedByMemberId])
  @@index([organizationId, status])
  @@index([scheduleSessionId])
  @@map("reschedule_request")
}